{
  "name": "ProStreetRPC CI Build & Publish Workflow",
  "jobs": [
    {
      "name": "Build and Release Job",
      "steps": [
        {
          "name": "1. Checkout Repository",
          "type": "checkout"
        },
        {
          "name": "2. Extract Version from library.cpp",
          "type": "set_var",
          "varName": "APP_VERSION",
          "command": "grep -oP 'const std::string version = \"\\K[^\"]+' library.cpp || echo '1.0'"
        },
        {
          "name": "3. Execute Cross-Compilation Build",
          "type": "command",
          "command": "bash build.sh"
        },
        {
          "name": "4. Upload Release Bundle",
          "type": "upload_artifact",
          "filePath": "build/ProStreetRPC_v@APP_VERSION@.zip",
          "version": "@APP_VERSION@",
          "title": "ProStreetRPC_v@APP_VERSION@.zip"
        }
      ]
    }
  ]
}
