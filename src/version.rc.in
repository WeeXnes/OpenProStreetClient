// The details Windows shows in the file's properties. CMake fills in the version from src/main.cpp,
// which is also where the release job reads it, so the launcher always sees the right one.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION @CLIENT_VERSION_MAJOR@,@CLIENT_VERSION_MINOR@,0,0
PRODUCTVERSION @CLIENT_VERSION_MAJOR@,@CLIENT_VERSION_MINOR@,0,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "WeeXnes"
            VALUE "FileDescription", "OpenProStreet Client, a community plugin for Need for Speed: ProStreet"
            VALUE "FileVersion", "@CLIENT_VERSION_DISPLAY@"
            VALUE "InternalName", "OpenProStreetClient"
            VALUE "LegalCopyright", "Copyright (C) WeeXnes. Not affiliated with Electronic Arts."
            VALUE "OriginalFilename", "OpenProStreetClient.asi"
            VALUE "ProductName", "OpenProStreet Client"
            VALUE "ProductVersion", "@CLIENT_VERSION_DISPLAY@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END
