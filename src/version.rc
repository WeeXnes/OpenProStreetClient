// The details Windows shows in the file's properties. Keep the version in step with src/main.cpp.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION 8,6,0,0
PRODUCTVERSION 8,6,0,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "WeeXnes"
            VALUE "FileDescription", "OpenProStreet Client, a community plugin for Need for Speed: ProStreet"
            VALUE "FileVersion", "8.6.0.0"
            VALUE "InternalName", "OpenProStreetClient"
            VALUE "LegalCopyright", "Copyright (C) WeeXnes. Not affiliated with Electronic Arts."
            VALUE "OriginalFilename", "OpenProStreetClient.asi"
            VALUE "ProductName", "OpenProStreet Client"
            VALUE "ProductVersion", "8.6.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END
